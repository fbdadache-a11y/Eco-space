<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Eco Space — Econovo Club</title>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@300;400;500;600;700;800&family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- Lucide Icons (user-requested) -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>

<!-- Supabase -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>

<style>
/* ══════════════════════════════════════════════════
   TOKENS — Econovo Brand
   Primary: #0E2A24  Sage: #8FB8A6  Light: #F4F7F2
══════════════════════════════════════════════════ */
:root {
  --primary:      #0E2A24;
  --primary-mid:  #1a4035;
  --primary-lite: #234d3d;
  --sage:         #8FB8A6;
  --sage-lite:    #b8d4c8;
  --sage-dim:     rgba(143,184,166,.15);
  --near-black:   #1F1F1F;
  --bg:           #F4F7F2;
  --bg-warm:      #F6F4F0;
  --bg-card:      #ffffff;
  --border:       #dde8e2;
  --border-mid:   #c2d5cc;
  --text:         #1F1F1F;
  --text-mid:     #3d5048;
  --text-muted:   #7a9089;
  --danger:       #c0392b;
  --danger-lite:  rgba(192,57,43,.1);
  --warn:         #d08000;
  --radius:       16px;
  --radius-sm:    10px;
  --radius-xs:    7px;
  --shadow-sm:    0 1px 4px rgba(14,42,36,.07), 0 2px 12px rgba(14,42,36,.05);
  --shadow-md:    0 4px 16px rgba(14,42,36,.10), 0 1px 4px rgba(14,42,36,.06);
  --shadow-lg:    0 12px 40px rgba(14,42,36,.14), 0 2px 8px rgba(14,42,36,.06);
  --font-head:    'Host Grotesk', sans-serif;
  --font-body:    'IBM Plex Sans Arabic', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
}

/* ─── SCREENS ─── */
.screen { display: none; min-height: 100vh; }
.screen.active { display: flex; }

/* ══════════════════════════════════════════════════
   PERMISSIONS OVERLAY  (shown first always)
══════════════════════════════════════════════════ */
#permissions-overlay {
  position: fixed; inset: 0;
  background: rgba(14,42,36,.6);
  backdrop-filter: blur(12px);
  z-index: 999;
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
}
#permissions-overlay.hidden { display: none; }

.perm-card {
  background: var(--bg-card);
  border-radius: 24px;
  padding: 48px 40px;
  max-width: 460px; width: 100%;
  box-shadow: var(--shadow-lg);
  text-align: center;
}
.perm-logo {
  width: 72px; height: 72px; margin: 0 auto 24px;
}
.perm-logo img { width: 100%; height: 100%; object-fit: contain; }
.perm-card h2 {
  font-family: var(--font-head);
  font-size: 1.5rem; font-weight: 700;
  color: var(--primary); margin-bottom: 10px;
}
.perm-card p {
  color: var(--text-muted); font-size: .9rem; line-height: 1.7; margin-bottom: 32px;
}
.perm-items {
  display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; text-align: right;
}
.perm-item {
  display: flex; align-items: center; gap: 12px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--radius-sm); padding: 12px 16px;
}
.perm-item-icon {
  width: 36px; height: 36px; border-radius: 10px;
  background: var(--sage-dim);
  display: flex; align-items: center; justify-content: center;
  color: var(--primary); flex-shrink: 0;
}
.perm-item-text { flex: 1; }
.perm-item-text strong { display: block; font-size: .85rem; font-weight: 600; color: var(--primary); }
.perm-item-text span  { font-size: .78rem; color: var(--text-muted); }
.perm-optional {
  font-size: .72rem; color: var(--text-muted);
  background: var(--bg-warm); border-radius: 6px; padding: 2px 8px;
  margin-right: auto; white-space: nowrap;
}

/* ══════════════════════════════════════════════════
   BUTTONS
══════════════════════════════════════════════════ */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 12px 24px;
  border: none; border-radius: var(--radius-sm);
  font-family: var(--font-body); font-size: .9rem; font-weight: 600;
  cursor: pointer; transition: all .18s; text-decoration: none;
  white-space: nowrap;
}
.btn-primary {
  background: var(--primary); color: #fff; width: 100%;
}
.btn-primary:hover { background: var(--primary-mid); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(14,42,36,.25); }
.btn-sage {
  background: var(--sage-dim); color: var(--primary);
  border: 1px solid var(--sage);
}
.btn-sage:hover { background: rgba(143,184,166,.25); }
.btn-ghost {
  background: transparent; border: 1px solid var(--border-mid); color: var(--text-mid);
}
.btn-ghost:hover { border-color: var(--primary); color: var(--primary); background: var(--sage-dim); }
.btn-sm { padding: 8px 16px; font-size: .8rem; }
.btn-danger { background: var(--danger-lite); color: var(--danger); border: 1px solid rgba(192,57,43,.2); }
.btn-danger:hover { background: rgba(192,57,43,.18); }

/* ══════════════════════════════════════════════════
   LANDING SCREEN
══════════════════════════════════════════════════ */
#landing {
  flex-direction: column;
  background: var(--bg);
}

/* ── NAV ── */
.nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px; height: 64px;
  background: var(--bg-card);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  position: sticky; top: 0; z-index: 10;
}
.nav-brand { display: flex; align-items: center; gap: 10px; }
.nav-brand img { height: 36px; width: auto; }
.nav-brand-text {
  font-family: var(--font-head); font-weight: 700;
  font-size: 1rem; color: var(--primary);
  line-height: 1.1;
}
.nav-brand-sub { font-size: .7rem; color: var(--text-muted); font-weight: 400; }
.live-badge {
  display: flex; align-items: center; gap: 6px;
  background: rgba(14,42,36,.07); border: 1px solid var(--border-mid);
  border-radius: 20px; padding: 5px 12px;
  font-size: .74rem; color: var(--text-mid); font-weight: 500;
}
.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sage); animation: pulse-dot 2s ease-in-out infinite; }
@keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.8)} }

/* ── HERO ── */
.hero {
  flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; padding: 80px 24px 60px;
  position: relative; overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; top: -120px; left: 50%; transform: translateX(-50%);
  width: 700px; height: 500px;
  background: radial-gradient(ellipse at center, rgba(143,184,166,.18) 0%, transparent 70%);
  pointer-events: none;
}

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 7px;
  background: var(--sage-dim); border: 1px solid var(--sage);
  border-radius: 20px; padding: 5px 14px;
  font-size: .75rem; color: var(--primary-lite); font-weight: 600;
  margin-bottom: 24px; letter-spacing: .4px;
}

.hero h1 {
  font-family: var(--font-head);
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 800; line-height: 1.1;
  color: var(--primary);
  letter-spacing: -1.5px;
  margin-bottom: 18px;
  max-width: 700px;
}
.hero h1 .sage-word { color: var(--sage); }

.hero-sub {
  font-size: 1rem; color: var(--text-muted); line-height: 1.75;
  max-width: 480px; margin-bottom: 48px;
}

.hero-actions {
  display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
}
.hero-actions .btn { min-width: 180px; padding: 14px 28px; font-size: .95rem; }

/* ── FEATURE STRIP ── */
.features-strip {
  display: flex; justify-content: center; flex-wrap: wrap;
  gap: 8px; padding: 24px 24px 60px;
}
.feat-chip {
  display: flex; align-items: center; gap: 7px;
  background: var(--bg-card); border: 1px solid var(--border);
  border-radius: 20px; padding: 7px 14px;
  font-size: .78rem; color: var(--text-mid); font-weight: 500;
}
.feat-chip svg { color: var(--sage); }

/* ══════════════════════════════════════════════════
   MODAL OVERLAY
══════════════════════════════════════════════════ */
.modal-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(14,42,36,.4);
  backdrop-filter: blur(8px);
  z-index: 100; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.open { display: flex; }

.modal {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 40px;
  width: 100%; max-width: 440px;
  position: relative;
  box-shadow: var(--shadow-lg);
  animation: modal-in .3s cubic-bezier(.16,1,.3,1);
}
@keyframes modal-in { from{opacity:0;transform:translateY(20px) scale(.97)} to{opacity:1;transform:none} }

.modal-close {
  position: absolute; top: 16px; left: 16px;
  background: var(--bg); border: 1px solid var(--border);
  color: var(--text-muted); width: 32px; height: 32px;
  border-radius: 8px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all .2s;
}
.modal-close:hover { border-color: var(--primary); color: var(--primary); }

.modal-header { margin-bottom: 28px; }
.modal-eyebrow {
  font-size: .72rem; font-weight: 600; letter-spacing: .8px;
  text-transform: uppercase; color: var(--sage); margin-bottom: 8px;
}
.modal h2 { font-family: var(--font-head); font-size: 1.4rem; font-weight: 700; color: var(--primary); }
.modal p.sub { font-size: .84rem; color: var(--text-muted); margin-top: 4px; }

/* form fields */
.field { margin-bottom: 16px; }
.field label {
  display: block; font-size: .75rem; font-weight: 600;
  color: var(--text-mid); margin-bottom: 7px; letter-spacing: .3px;
}
.field input, .field select {
  width: 100%;
  background: var(--bg);
  border: 1.5px solid var(--border);
  border-radius: var(--radius-xs);
  padding: 11px 14px;
  color: var(--text);
  font-family: var(--font-body);
  font-size: .9rem;
  outline: none;
  transition: border-color .18s, box-shadow .18s;
  appearance: none;
}
.field input:focus, .field select:focus {
  border-color: var(--sage);
  box-shadow: 0 0 0 3px rgba(143,184,166,.2);
}
.field input::placeholder { color: var(--text-muted); }

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

/* room link preview */
.link-preview {
  margin-top: 18px;
  background: var(--bg);
  border: 1.5px solid var(--sage);
  border-radius: var(--radius-xs);
  padding: 10px 14px;
  display: flex; align-items: center; gap: 10px;
}
.link-preview code { font-family: monospace; font-size: .78rem; color: var(--primary); word-break: break-all; flex: 1; }
.copy-btn {
  background: var(--sage-dim); border: 1px solid var(--sage);
  color: var(--primary); padding: 5px 12px;
  border-radius: 6px; cursor: pointer; font-size: .74rem; font-weight: 600;
  transition: all .2s; white-space: nowrap;
}
.copy-btn:hover { background: rgba(143,184,166,.3); }

/* status message */
.status-msg {
  padding: 10px 14px; border-radius: var(--radius-xs);
  font-size: .82rem; margin-top: 14px; display: none;
}
.status-msg.ok  { background: rgba(14,42,36,.08); color: var(--primary); border: 1px solid var(--border-mid); }
.status-msg.err { background: var(--danger-lite); color: var(--danger); border: 1px solid rgba(192,57,43,.2); }
.status-msg.show { display: block; }

/* ══════════════════════════════════════════════════
   ROOM SCREEN
══════════════════════════════════════════════════ */
#room {
  flex-direction: column;
  height: 100vh; overflow: hidden;
  background: var(--near-black);
}

/* ── Room Header ── */
.room-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 20px; height: 58px;
  background: #0d1a16;
  border-bottom: 1px solid rgba(143,184,166,.15);
  flex-shrink: 0; gap: 12px;
  z-index: 5;
}
.rh-brand { display: flex; align-items: center; gap: 10px; }
.rh-brand img { height: 28px; filter: brightness(2); }
.rh-sep { width: 1px; height: 20px; background: rgba(255,255,255,.12); }
.rh-room-name {
  font-family: var(--font-head);
  font-weight: 600; font-size: .92rem;
  color: rgba(255,255,255,.85);
}
.rh-meta { display: flex; align-items: center; gap: 8px; }
.rh-pill {
  display: flex; align-items: center; gap: 6px;
  background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px; padding: 4px 12px;
  font-size: .73rem; color: rgba(255,255,255,.55);
}
.rh-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--sage); animation: pulse-dot 2s infinite; }
.rh-share-btn {
  display: flex; align-items: center; gap: 6px;
  background: rgba(143,184,166,.12); border: 1px solid rgba(143,184,166,.25);
  color: var(--sage); padding: 7px 14px;
  border-radius: 8px; cursor: pointer; font-family: var(--font-body);
  font-size: .78rem; font-weight: 600; transition: all .18s;
}
.rh-share-btn:hover { background: rgba(143,184,166,.2); }
.rh-leave {
  display: flex; align-items: center; gap: 6px;
  background: rgba(192,57,43,.12); border: 1px solid rgba(192,57,43,.25);
  color: #e74c3c; padding: 7px 14px;
  border-radius: 8px; cursor: pointer; font-family: var(--font-body);
  font-size: .78rem; font-weight: 600; transition: all .18s;
}
.rh-leave:hover { background: rgba(192,57,43,.22); }

/* ── Room Body ── */
.room-body { display: flex; flex: 1; overflow: hidden; }

/* ── VIDEO AREA ── */
.video-area {
  flex: 1; background: #0a0f0d;
  display: flex; flex-direction: column; overflow: hidden;
}

.video-grid {
  flex: 1; display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 8px; padding: 12px; overflow-y: auto;
  align-content: start;
}

.video-tile {
  background: #111a16;
  border-radius: var(--radius);
  overflow: hidden; position: relative;
  aspect-ratio: 16/9;
  border: 1.5px solid rgba(143,184,166,.12);
  transition: border-color .2s;
}
.video-tile.speaking {
  border-color: var(--sage);
  box-shadow: 0 0 0 2px rgba(143,184,166,.15);
}
.video-tile.screen-tile {
  grid-column: 1 / -1;
  border-color: rgba(143,184,166,.3);
}
.video-tile video {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}
.video-placeholder {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 12px;
  background: linear-gradient(135deg, #111e18, #0d1510);
}
.v-avatar {
  width: 68px; height: 68px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-head); font-size: 1.6rem; font-weight: 700;
}
.v-name-tag {
  position: absolute; bottom: 10px; right: 10px;
  background: rgba(0,0,0,.55); backdrop-filter: blur(6px);
  border-radius: 6px; padding: 4px 10px;
  font-size: .74rem; font-weight: 500; color: rgba(255,255,255,.85);
  display: flex; align-items: center; gap: 6px;
}
.screen-badge {
  position: absolute; top: 10px; right: 10px;
  background: var(--sage); color: var(--primary);
  border-radius: 6px; padding: 3px 10px;
  font-size: .72rem; font-weight: 700; letter-spacing: .3px;
}

/* ── CONTROLS BAR ── */
.controls-bar {
  height: 80px;
  background: #0d1a16;
  border-top: 1px solid rgba(143,184,166,.12);
  display: flex; align-items: center; justify-content: center;
  gap: 10px; flex-shrink: 0; padding: 0 20px;
}
.ctrl-btn {
  width: 48px; height: 48px; border-radius: 50%;
  border: 1.5px solid rgba(143,184,166,.2);
  background: rgba(143,184,166,.07);
  color: rgba(255,255,255,.75);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: all .18s; position: relative;
}
.ctrl-btn:hover { background: rgba(143,184,166,.15); transform: scale(1.07); }
.ctrl-btn.on { background: var(--sage); border-color: var(--sage); color: var(--primary); }
.ctrl-btn.off { background: rgba(192,57,43,.15); border-color: rgba(192,57,43,.35); color: #e74c3c; }
.ctrl-btn.screen-on { background: var(--primary); border-color: var(--sage); color: var(--sage); }

.ctrl-tooltip {
  position: absolute; bottom: -22px; left: 50%; transform: translateX(-50%);
  font-size: .6rem; color: rgba(255,255,255,.4); white-space: nowrap;
  font-family: var(--font-body); pointer-events: none;
}
.ctrl-sep { width: 1px; height: 26px; background: rgba(255,255,255,.1); margin: 0 4px; }

.end-call-btn {
  width: 58px; height: 46px; border-radius: 23px;
  background: var(--danger); border: none; color: #fff;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: all .18s; position: relative;
}
.end-call-btn:hover { background: #a93226; transform: scale(1.05); box-shadow: 0 4px 16px rgba(192,57,43,.4); }

/* ── SIDEBAR ── */
.sidebar {
  width: 310px; flex-shrink: 0;
  background: #0d1a16;
  border-right: 1px solid rgba(143,184,166,.12);
  display: flex; flex-direction: column;
  overflow: hidden; transition: width .28s ease;
}
.sidebar.collapsed { width: 0; }

.sidebar-tabs {
  display: flex; border-bottom: 1px solid rgba(143,184,166,.12);
  flex-shrink: 0;
}
.stab {
  flex: 1; padding: 14px 0;
  display: flex; align-items: center; justify-content: center; gap: 6px;
  font-size: .78rem; font-weight: 600; color: rgba(255,255,255,.4);
  cursor: pointer; border-bottom: 2px solid transparent;
  transition: all .18s; white-space: nowrap;
}
.stab.active { color: var(--sage); border-bottom-color: var(--sage); }
.tab-badge {
  background: var(--sage); color: var(--primary);
  border-radius: 10px; font-size: .65rem; font-weight: 700;
  padding: 1px 6px; display: none;
}
.tab-badge.show { display: block; }

.stab-panel { display: none; flex: 1; overflow: hidden; flex-direction: column; }
.stab-panel.active { display: flex; }

/* participants */
.participants-list { padding: 10px; overflow-y: auto; flex: 1; }
.p-row {
  display: flex; align-items: center; gap: 10px;
  padding: 9px 10px; border-radius: var(--radius-xs);
  transition: background .15s;
}
.p-row:hover { background: rgba(143,184,166,.07); }
.p-av {
  width: 36px; height: 36px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem; font-weight: 700; flex-shrink: 0;
  font-family: var(--font-head);
}
.p-info { flex: 1; min-width: 0; }
.p-name { font-size: .82rem; font-weight: 600; color: rgba(255,255,255,.85); }
.p-role { font-size: .68rem; color: rgba(255,255,255,.35); margin-top: 1px; }
.p-icons { display: flex; gap: 5px; }
.p-icons .icon-on  { color: var(--sage); }
.p-icons .icon-off { color: #e74c3c; opacity: .7; }

/* chat */
.chat-messages {
  flex: 1; padding: 12px; overflow-y: auto;
  display: flex; flex-direction: column; gap: 12px;
}
.chat-sys {
  text-align: center; font-size: .72rem;
  color: rgba(255,255,255,.3); padding: 4px 0;
}
.msg { display: flex; gap: 8px; align-items: flex-start; }
.msg.self { flex-direction: row-reverse; }
.msg-av {
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .78rem; font-weight: 700; flex-shrink: 0;
  font-family: var(--font-head);
}
.msg-body { max-width: 85%; }
.msg-meta { display: flex; align-items: center; gap: 7px; margin-bottom: 3px; }
.msg.self .msg-meta { flex-direction: row-reverse; }
.msg-sender { font-size: .72rem; font-weight: 600; color: rgba(255,255,255,.55); }
.msg-time   { font-size: .65rem; color: rgba(255,255,255,.25); }
.msg-bubble {
  background: rgba(255,255,255,.07);
  border: 1px solid rgba(255,255,255,.08);
  border-radius: 10px 10px 10px 3px;
  padding: 8px 12px; font-size: .84rem; line-height: 1.55;
  color: rgba(255,255,255,.8); word-break: break-word;
}
.msg.self .msg-bubble {
  background: rgba(143,184,166,.15);
  border-color: rgba(143,184,166,.25);
  border-radius: 10px 10px 3px 10px;
  color: rgba(255,255,255,.9);
}

.chat-input-area {
  padding: 10px; border-top: 1px solid rgba(143,184,166,.1); flex-shrink: 0;
}
.chat-input-row {
