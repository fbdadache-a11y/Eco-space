<script>
/* ═══════════════════════════════════════════════
   SUPABASE CLIENT
═══════════════════════════════════════════════ */
const SUPA_URL = 'https://fjiyckxmtksmqhyllirt.supabase.co';
const SUPA_KEY = 'sb_publishable_j2r_CQ1zaGOj2geMRctGeA_VHczbw0l';
let sb = null;
let realtimeCh = null;

async function initSupabase() {
  try {
    sb = supabase.createClient(SUPA_URL, SUPA_KEY);
    // verify connection
    const { error } = await sb.from('rooms').select('id').limit(1);
    const badge = document.getElementById('db-badge');
    if (error && error.code !== 'PGRST116') {
      badge.className = 'db-status offline';
      badge.innerHTML = '<i data-lucide="wifi-off" width="11" height="11"></i> غير متصل';
    } else {
      badge.className = 'db-status connected';
      badge.innerHTML = '<i data-lucide="check-circle" width="11" height="11"></i> Supabase متصل';
    }
    lucide.createIcons();
  } catch(e) {
    const badge = document.getElementById('db-badge');
    badge.className = 'db-status offline';
    badge.innerHTML = '<i data-lucide="wifi-off" width="11" height="11"></i> غير متصل';
    lucide.createIcons();
  }
}

/* ═══════════════════════════════════════════════
   STATE
═══════════════════════════════════════════════ */
const S = {
  myName: '',
  roomName: '',
  roomCode: '',
  roomId: null,
  participantId: null,
  myUserId: null,
  micOn: true,
  camOn: true,
  screenOn: false,
  sidebarOpen: true,
  activeTab: 'chat',
  localStream: null,
  screenStream: null,
  participants: [],
  messages: [],
  unread: 0,
  permGranted: false,
};

const COLORS = [
  ['#0E2A24','#8FB8A6'],['#8FB8A6','#0E2A24'],
  ['#2d6a4f','#fff'],  ['#1b4332','#8FB8A6'],
  ['#40916c','#fff'],  ['#52b788','#0E2A24'],
];

function col(i) { return COLORS[i % COLORS.length]; }

/* ═══════════════════════════════════════════════
   PERMISSIONS
═══════════════════════════════════════════════ */
async function requestPermissions() {
  try {
    S.localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
    S.permGranted = true;
    toast('الكاميرا والميكروفون جاهزان', 'ok');
  } catch(e) {
    S.permGranted = false;
    toast('تعذّر الوصول — يمكنك المتابعة بدونها', 'warn');
  }
  document.getElementById('permissions-overlay').classList.add('hidden');
}

function skipPermissions() {
  S.permGranted = false;
  document.getElementById('permissions-overlay').classList.add('hidden');
  toast('انضممت بدون كاميرا', 'info');
}

/* ═══════════════════════════════════════════════
   MODALS
═══════════════════════════════════════════════ */
function openModal(id) { document.getElementById('modal-'+id).classList.add('open'); }
function closeModal(id) { document.getElementById('modal-'+id).classList.remove('open'); }

/* ═══════════════════════════════════════════════
   CREATE ROOM
═══════════════════════════════════════════════ */
function genCode() {
  return Math.random().toString(36).slice(2,10);
}

async function createRoom() {
  const name = document.getElementById('c-name').value.trim();
  const roomLabel = document.getElementById('c-room').value.trim() || 'غرفة Econovo';
  if (!name) { showStatus('create','أدخل اسمك أولاً','err'); return; }

  const btn = document.getElementById('create-btn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner show" style="width:16px;height:16px;border-color:rgba(255,255,255,.3);border-top-color:#fff;display:inline-block"></div> جارٍ الإنشاء…';

  S.myName = name;
  S.roomName = roomLabel;
  S.roomCode = genCode();

  let roomDbId = null;

  // Try Supabase insert
  if (sb) {
    try {
      // ensure user row
      const { data: uData } = await sb.from('users')
        .insert([{ display_name: name, is_guest: true }])
        .select('id').single();
      if (uData) S.myUserId = uData.id;

      const { data: rData, error: rErr } = await sb.from('rooms')
        .insert([{
          code: S.roomCode,
          name: roomLabel,
          owner_id: S.myUserId || '00000000-0000-0000-0000-000000000000',
          status: 'active'
        }])
        .select('id').single();

      if (!rErr && rData) {
        roomDbId = rData.id;
        S.roomId = roomDbId;
        // add as host
        const { data: pData } = await sb.from('room_participants')
          .insert([{ room_id: roomDbId, user_id: S.myUserId, role: 'host' }])
          .select('id').single();
        if (pData) S.participantId = pData.id;
      }
    } catch(e) { /* offline — continue locally */ }
  }

  const link = `${location.origin}${location.pathname}?r=${S.roomCode}`;
  document.getElementById('link-text').textContent = link;
  document.getElementById('room-link-box').style.display = 'block';
  showStatus('create','✓ الغرفة جاهزة — شارك الرابط أدناه','ok');

  btn.disabled = false;
  btn.innerHTML = '<i data-lucide="check" width="16" height="16"></i> جاهز';
  lucide.createIcons();

  setTimeout(() => {
    closeModal('create');
    enterRoom();
  }, 1600);
}

/* ═══════════════════════════════════════════════
   JOIN ROOM
═══════════════════════════════════════════════ */
async function joinRoom() {
  const name = document.getElementById('j-name').value.trim();
  const link = document.getElementById('j-link').value.trim();
  if (!name) { showStatus('join','أدخل اسمك','err'); return; }
  if (!link) { showStatus('join','أدخل رابط الغرفة','err'); return; }

  const btn = document.getElementById('join-btn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner show" style="width:16px;height:16px;border-color:rgba(255,255,255,.3);border-top-color:#fff;display:inline-block"></div> جارٍ الانضمام…';

  S.myName = name;
  // extract code
  const code = link.split('?r=').pop().split('/').pop().split('?').shift().trim();
  S.roomCode = code;

  if (sb) {
    try {
      const { data: room } = await sb.from('rooms')
        .select('id,name,status').eq('code', code).single();
      if (room) {
        S.roomId = room.id;
        S.roomName = room.name;
        if (room.status !== 'active') {
          showStatus('join','هذه الغرفة مُغلقة أو انتهت','err');
          btn.disabled = false; btn.innerHTML = 'الانضمام الآن';
          return;
        }
        // insert participant
        const { data: uData } = await sb.from('users')
          .insert([{ display_name: name, is_guest: true }])
          .select('id').single();
        if (uData) S.myUserId = uData.id;
        const { data: pData } = await sb.from('room_participants')
          .insert([{ room_id: S.roomId, user_id: S.myUserId, role: 'participant' }])
          .select('id').single();
        if (pData) S.participantId = pData.id;
      } else {
        S.roomName = 'غرفة مشتركة';
        showStatus('join','لم يتم إيجاد الغرفة — دخول محلي','ok');
      }
    } catch(e) { S.roomName = 'غرفة مشتركة'; }
  } else {
    S.roomName = 'غرفة مشتركة';
  }

  closeModal('join');
  enterRoom();
}

/* ═══════════════════════════════════════════════
   ENTER ROOM
═══════════════════════════════════════════════ */
async function enterRoom() {
  document.getElementById('landing').classList.remove('active');
  document.getElementById('room').classList.add('active');
  document.getElementById('rh-name').textContent = S.roomName;

  S.participants = [{
    id: 'me', name: S.myName, isMe: true,
    micOn: true, camOn: !!S.localStream, colorIdx: 0, role: 'host'
  }];

  // if permissions not yet granted and no stream
  if (!S.localStream) {
    try {
      S.localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
      S.participants[0].camOn = true;
    } catch(e) {
      S.participants[0].camOn = false;
    }
  }

  renderGrid();
  renderPeople();
  addSysMsg(`أهلاً ${S.myName}! انضممت إلى "${S.roomName}"`);
  updateCount();

  // Supabase Realtime subscription
  if (sb && S.roomId) {
    realtimeCh = sb.channel(`room:${S.roomId}`)
      .on('postgres_changes', {
        event: 'INSERT', schema: 'public', table: 'messages',
        filter: `room_id=eq.${S.roomId}`
      }, payload => {
        if (payload.new && payload.new.sender_id !== S.myUserId) {
          S.messages.push({
            id: payload.new.id,
            sender: payload.new.sender_name || 'مشترك',
            text: payload.new.body,
            time: new Date(payload.new.created_at).toLocaleTimeString('ar',{hour:'2-digit',minute:'2-digit'}),
            isMe: false, colorIdx: 1
          });
          renderMessages();
          if (S.activeTab !== 'chat') { S.unread++; updateBadge(); }
        }
      })
      .on('postgres_changes', {
        event: '*', schema: 'public', table: 'room_participants',
        filter: `room_id=eq.${S.roomId}`
      }, () => {
        loadParticipants();
      })
      .subscribe();
  }

  lucide.createIcons();
}

/* ═══════════════════════════════════════════════
   GRID
═══════════════════════════════════════════════ */
function renderGrid() {
  const grid = document.getElementById('v-grid');
  grid.innerHTML = '';

  // screen share tile
  if (S.screenOn) {
    const tile = document.createElement('div');
    tile.className = 'video-tile screen-tile';
    const vid = document.createElement('video');
    vid.autoplay = true; vid.muted = true; vid.playsInline = true;
    if (S.screenStream) vid.srcObject = S.screenStream;
    tile.appendChild(vid);
    const badge = document.createElement('div');
    badge.className = 'screen-badge';
    badge.innerHTML = '<i data-lucide="monitor" width="11" height="11" style="display:inline-block;vertical-align:middle;margin-left:4px"></i> مشاركة الشاشة';
    tile.appendChild(badge);
    grid.appendChild(tile);
  }

  S.participants.forEach((p, i) => {
    const [bg, fg] = col(p.colorIdx ?? i);
    const tile = document.createElement('div');
    tile.className = 'video-tile';
    tile.id = 'tile-' + p.id;

    if (p.isMe && S.localStream && p.camOn) {
      const vid = document.createElement('video');
      vid.autoplay = true; vid.muted = true; vid.playsInline = true;
      vid.srcObject = S.localStream;
      tile.appendChild(vid);
    } else {
      const ph = document.createElement('div');
      ph.className = 'video-placeholder';
      ph.innerHTML = `
        <div class="v-avatar" style="background:${bg};color:${fg}">${p.name.charAt(0)}</div>
        <span style="font-size:.74rem;color:rgba(255,255,255,.4)">${p.name}</span>`;
      tile.appendChild(ph);
    }

    const tag = document.createElement('div');
    tag.className = 'v-name-tag';
    tag.innerHTML = `
      ${p.name}
      ${p.isMe ? '<span style="color:var(--sage);font-size:.65rem">(أنت)</span>' : ''}
      ${!p.micOn ? '<i data-lucide="mic-off" width="11" height="11" style="color:#e74c3c"></i>' : ''}`;
    tile.appendChild(tag);
    grid.appendChild(tile);
  });

  lucide.createIcons();
}

/* ═══════════════════════════════════════════════
   CONTROLS
═══════════════════════════════════════════════ */
function toggleMic() {
  S.micOn = !S.micOn;
  if (S.localStream) S.localStream.getAudioTracks().forEach(t => t.enabled = S.micOn);
  const btn = document.getElementById('mic-btn');
  btn.className = 'ctrl-btn ' + (S.micOn ? 'on' : 'off');
  btn.querySelector('i').setAttribute('data-lucide', S.micOn ? 'mic' : 'mic-off');
  S.participants[0].micOn = S.micOn;
  renderPeople(); renderGrid();
  lucide.createIcons();
  // update DB
  if (sb && S.participantId) {
    sb.from('room_participants').update({ mic_on: S.micOn }).eq('id', S.participantId).then(() => {});
  }
  toast(S.micOn ? 'الميكروفون مفعّل' : 'الميكروفون مكتوم', 'info');
}

function toggleCam() {
  S.camOn = !S.camOn;
  if (S.localStream) S.localStream.getVideoTracks().forEach(t => t.enabled = S.camOn);
  const btn = document.getElementById('cam-btn');
  btn.className = 'ctrl-btn ' + (S.camOn ? 'on' : 'off');
  btn.querySelector('i').setAttribute('data-lucide', S.camOn ? 'video' : 'video-off');
  S.participants[0].camOn = S.camOn;
  renderGrid();
  lucide.createIcons();
  if (sb && S.participantId) {
    sb.from('room_participants').update({ cam_on: S.camOn }).eq('id', S.participantId).then(() => {});
  }
  toast(S.camOn ? 'الكاميرا مفعّلة' : 'الكاميرا معطّلة', 'info');
}

async function toggleScreen() {
  if (!S.screenOn) {
    try {
      S.screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
      S.screenOn = true;
      const btn = document.getElementById('screen-btn');
      btn.className = 'ctrl-btn screen-on';
      S.screenStream.getVideoTracks()[0].onended = stopScreen;
      if (sb && S.roomId) {
        await sb.from('screen_shares').insert([{ room_id: S.roomId, presenter_id: S.myUserId }]);
      }
      renderGrid();
      toast('مشاركة الشاشة بدأت', 'ok');
    } catch(e) { toast('تم إلغاء مشاركة الشاشة', 'warn'); }
  } else { stopScreen(); }
}

function stopScreen() {
  if (S.screenStream) S.screenStream.getTracks().forEach(t => t.stop());
  S.screenStream = null; S.screenOn = false;
  document.getElementById('screen-btn').className = 'ctrl-btn';
  renderGrid();
  toast('تم إيقاف مشاركة الشاشة', 'info');
}

function toggleSidebar() {
  S.sidebarOpen = !S.sidebarOpen;
  document.getElementById('sidebar').classList.toggle('collapsed', !S.sidebarOpen);
  const btn = document.getElementById('sidebar-btn');
  btn.className = 'ctrl-btn ' + (S.sidebarOpen ? 'on' : '');
}

function togglePeople() { switchTab('people'); if (!S.sidebarOpen) toggleSidebar(); }

/* ═══════════════════════════════════════════════
   TABS
═══════════════════════════════════════════════ */
function switchTab(tab) {
  S.activeTab = tab;
  document.querySelectorAll('.stab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.stab-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('tab-'+tab+'-btn').classList.add('active');
  document.getElementById('panel-'+tab).classList.add('active');
  if (tab === 'chat') { S.unread = 0; updateBadge(); }
}

function updateBadge() {
  const b = document.getElementById('chat-badge');
  b.textContent = S.unread;
  b.className = 'tab-badge' + (S.unread > 0 ? ' show' : '');
}

/* ═══════════════════════════════════════════════
   CHAT
═══════════════════════════════════════════════ */
function handleKey(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
}
function autoResize(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 90) + 'px'; }

async function sendMessage() {
  const inp = document.getElementById('chat-input');
  const text = inp.value.trim();
  if (!text) return;

  const now = new Date();
  const timeStr = now.toLocaleTimeString('ar',{hour:'2-digit',minute:'2-digit'});

  const msg = { id: Date.now(), sender: S.myName, text, time: timeStr, isMe: true, colorIdx: 0 };
  S.messages.push(msg);
  inp.value = ''; inp.style.height = 'auto';
  renderMessages();

  // persist to Supabase
  if (sb && S.roomId && S.myUserId) {
    try {
      await sb.from('messages').insert([{
        room_id: S.roomId,
        sender_id: S.myUserId,
        body: text,
        message_type: 'text'
      }]);
    } catch(e) { /* offline */ }
  }
}

function addSysMsg(text) {
  const el = document.getElementById('chat-messages');
  const d = document.createElement('div');
  d.className = 'chat-sys'; d.textContent = text;
  el.appendChild(d);
  el.scrollTop = el.scrollHeight;
}

function renderMessages() {
  const el = document.getElementById('chat-messages');
  // remove .msg elements, keep .chat-sys
  el.querySelectorAll('.msg').forEach(m => m.remove());
  S.messages.forEach(m => {
    const [bg,fg] = col(m.colorIdx ?? 0);
    const d = document.createElement('div');
    d.className = 'msg' + (m.isMe ? ' self' : '');
    d.innerHTML = `
      <div class="msg-av" style="background:${bg};color:${fg}">${m.sender.charAt(0)}</div>
      <div class="msg-body">
        <div class="msg-meta">
          <span class="msg-sender">${m.sender}</span>
          <span class="msg-time">${m.time}</span>
        </div>
        <div class="msg-bubble">${esc(m.text)}</div>
      </div>`;
    el.appendChild(d);
  });
  el.scrollTop = el.scrollHeight;
}

function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

/* ═══════════════════════════════════════════════
   PARTICIPANTS
═══════════════════════════════════════════════ */
function renderPeople() {
  const el = document.getElementById('ppl-list');
  el.innerHTML = '';
  S.participants.forEach((p, i) => {
    const [bg,fg] = col(p.colorIdx ?? i);
    el.innerHTML += `
      <div class="p-row">
        <div class="p-av" style="background:${bg};color:${fg}">${p.name.charAt(0)}</div>
        <div class="p-info">
          <div class="p-name">${p.name}${p.isMe?' <span style="color:rgba(143,184,166,.6);font-size:.65rem">(أنت)</span>':''}</div>
          <div class="p-role">${p.role === 'host' ? 'المضيف' : 'مشترك'}</div>
        </div>
        <div class="p-icons">
          <span class="${p.micOn?'icon-on':'icon-off'}">
            <i data-lucide="${p.micOn?'mic':'mic-off'}" width="13" height="13"></i>
          </span>
          <span class="${p.camOn?'icon-on':'icon-off'}">
            <i data-lucide="${p.camOn?'video':'video-off'}" width="13" height="13"></i>
          </span>
        </div>
      </div>`;
  });
  lucide.createIcons();
}

async function loadParticipants() {
  if (!sb || !S.roomId) return;
  const { data } = await sb.from('room_participants')
    .select('id,role,mic_on,cam_on,users(display_name)')
    .eq('room_id', S.roomId)
    .is('left_at', null);
  if (!data) return;

  S.participants = data.map((r,i) => ({
    id: r.id,
    name: r.users?.display_name || 'مشترك',
    isMe: r.id === S.participantId,
    micOn: r.mic_on,
    camOn: r.cam_on,
    role: r.role,
    colorIdx: i
  }));
  renderPeople(); renderGrid();
  updateCount();
}

function updateCount() {
  document.getElementById('rh-count').textContent = `${S.participants.length} مشترك`;
}

/* ═══════════════════════════════════════════════
   SHARE / LEAVE
═══════════════════════════════════════════════ */
function shareRoomLink() {
  const link = `${location.origin}${location.pathname}?r=${S.roomCode}`;
  if (navigator.clipboard) navigator.clipboard.writeText(link).then(() => toast('تم نسخ الرابط!','ok'));
  else toast('الرابط: ?r=' + S.roomCode,'info');
}

function copyLink() {
  const t = document.getElementById('link-text').textContent;
  if (navigator.clipboard) navigator.clipboard.writeText(t).then(() => toast('تم النسخ','ok'));
}

async function leaveRoom() {
  // mark as left in DB
  if (sb && S.participantId) {
    await sb.from('room_participants').update({ left_at: new Date().toISOString() }).eq('id', S.participantId).then(() => {});
  }
  if (realtimeCh) { sb.removeChannel(realtimeCh); realtimeCh = null; }
  if (S.localStream) { S.localStream.getTracks().forEach(t=>t.stop()); S.localStream = null; }
  if (S.screenStream) { S.screenStream.getTracks().forEach(t=>t.stop()); S.screenStream = null; }
  Object.assign(S, {
    participants:[], messages:[], micOn:true, camOn:true,
    screenOn:false, roomId:null, participantId:null,
    myUserId:null, unread:0
  });
  document.getElementById('mic-btn').className = 'ctrl-btn on';
  document.getElementById('cam-btn').className = 'ctrl-btn on';
  document.getElementById('screen-btn').className = 'ctrl-btn';
  document.getElementById('room').classList.remove('active');
  document.getElementById('landing').classList.add('active');
  toast('غادرت المساحة', 'info');
}

/* ═══════════════════════════════════════════════
   STATUS MESSAGES
═══════════════════════════════════════════════ */
function showStatus(modal, text, type) {
  const el = document.getElementById(modal+'-status');
  el.textContent = text;
  el.className = 'status-msg ' + type + ' show';
  setTimeout(() => el.classList.remove('show'), 4000);
}

/* ═══════════════════════════════════════════════
   TOAST
═══════════════════════════════════════════════ */
function toast(text, type='info') {
  const el = document.createElement('div');
  el.className = 'toast';
  el.style.borderColor = type==='ok'?'rgba(143,184,166,.5)':type==='warn'?'rgba(210,152,0,.4)':type==='err'?'rgba(192,57,43,.4)':'rgba(143,184,166,.2)';
  el.textContent = text;
  document.getElementById('toasts').appendChild(el);
  setTimeout(() => el.remove(), 3200);
}

/* ═══════════════════════════════════════════════
   AUTO JOIN FROM URL
═══════════════════════════════════════════════ */
function checkUrlParams() {
  const params = new URLSearchParams(location.search);
  const code = params.get('r');
  if (code) {
    document.getElementById('j-link').value = `?r=${code}`;
    setTimeout(() => openModal('join'), 600);
  }
}

/* ═══════════════════════════════════════════════
   INIT
═══════════════════════════════════════════════ */
window.addEventListener('DOMContentLoaded', () => {
  lucide.createIcons();
  initSupabase();
  checkUrlParams();
});
</script>
